        // GLOVES
            ItemDisplay[EQ4 IAS>0 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK50>1)]: %NAME%%NOTIFY(WHITE)%  
        // CLAW
            ItemDisplay[(MAG OR RARE) CL5 ((CLSK6>0 AND (SK271>2 OR SK262>2 OR SK272>2 OR SK277>2 OR SK278>2)) OR (CLSK6>1 AND (SK271>1 OR SK262>1 OR SK272>1 OR SK277>1 OR SK278>1)) OR (TABSK48>0 AND (SK271>2 OR SK262>2 OR SK272>2 OR SK277>2)) OR (TABSK48>1 AND (SK271>1 OR SK262>1 OR SK272>1 OR SK277>1)) OR (TABSK49>0 AND SK278>2) OR (TABSK49>1 AND SK278>1))]: %NAME%%NOTIFY(WHITE)%  
            ItemDisplay[MAG CL5 ID TABSK48=3]: %NAME%%NOTIFY(WHITE)%
        // PALADIN SCEPTER
            ItemDisplay[!UNI WP13 ((TABSK24=3 AND (SK121>1 OR SK101>1)) OR (TABSK24=2 AND (SK121>2 OR SK101>2)) OR (TABSK25=3 AND (SK119>1 OR SK102>1 OR SK114>1 OR SK118>1 OR SK113>1 OR SK122>1 OR SK123>1)) OR (TABSK25=3 AND SK125>1))]: %NAME%%NOTIFY(WHITE)%  // SHOPPING PAL Scepter
        // BARBARIAN
