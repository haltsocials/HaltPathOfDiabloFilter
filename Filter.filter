            ItemDisplay[CL2 !UNI SK149>2 (TABSK34>2 OR CLSK4>1)]: %NAME%%NOTIFY(WHITE)%  //  5BO/6BO
        // DRUID
            ItemDisplay[CL1 !UNI ((CLSK5=2 AND (SK221=3 OR SK226=3 OR SK236=3 OR SK237=3 OR SK238=3 OR SK240=3 OR SK243=3 OR SK245=3 OR SK247=3 OR SK249=3 OR SK250=3)) OR (TABSK40=3 AND (SK221>1 OR SK226>1 OR SK236>1 OR SK237>1 OR SK247>1)) OR (TABSK40=2 AND (SK221>2 OR SK226>2 OR SK236>2 OR SK237>2 OR SK247>2)) OR (TABSK41=3 AND (SK238>1 OR SK243>1)) OR (TABSK41=2 AND (SK238>2 OR SK243>2)) OR (TABSK42=3 AND (SK240>1 OR SK245>1 OR SK249>1 OR SK250>1)) OR (TABSK42=2 AND (SK240>2 OR SK245>2 OR SK249>2 OR SK250>2)))]: %NAME%%NOTIFY(WHITE)%  
        // NECROMANCER
