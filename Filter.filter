Attribute[Author]: Halt 
Attribute[Name]: PathOFDiabloFilter
Attribute[Version]: #1
Attribute[Date]: 2026/10/18

// FILTER LEVELS
    // Basic ladder progression and leveling. Shows items for leveling alts
    FilterLevel[1]: Normal 
    // Hides random rares/bases, low use uniques/set, magic ring/amulet, vendor items
    FilterLevel[2]: ÿc8Semi Strict
    FilterLevel[3]: ÿc8Semi Strict (HP/MP)
    // Only shows BIS bases, high value uniques and runes
    FilterLevel[4]: ÿc1Strict 
    FilterLevel[5]: ÿc1Strict (HP/MP)
    Option[DefaultFilterLevel]: Normal
    Option[DefaultNotifyLevel]: LOW

// STYLES
    ItemStyle[LOW]: MapIcon = 50, NotificationColor = WHITE, NotificationSound = 418, BorderSize = 2
    ItemStyle[MID]: MapIcon = 51, NotificationColor = WHITE, NotificationSound = 35, BorderColor = 15, BorderSize = 2
    ItemStyle[HIGH]: MapIcon = 49, NotificationColor = WHITE, NotificationSound = 34, BorderColor = 15, BorderSize = 2
    ItemStyle[MAP]: MapIcon = 75, NotificationColor = WHITE, NotificationSound = 418, BorderColor = 15, BorderSize = 2
    ItemStyle[CHARM]: MapIcon = 6, BorderColor = 4, BorderSize = 2
    ItemStyle[JEWEL]: MapIcon = 63, NotificationColor = WHITE, BorderColor = 4, BorderSize = 2
    ItemStyle[LEVEL]: MapIcon = 67, NotificationColor = WHITE

//CUSTOM/SSF
    //ItemDisplay[key]: %NAME% {} //TEST 
    //ItemDisplay[WP12 STAT388>0]: %NAME%<<LOW>>

//TO DO
    // Colors of items. Should match rarity
    // Evaluate set/unique section
    // All same Character circle or otherwise
    // Show RW even if base is filtered
    // CLEAN 
        // MAG section 
        // reduce lines, comment, consistent syntax
    // TEST - Evaluate filter levels, change colors/legibility in game
        // HIDE ID'd trash?

// BASE
    // CHARM NAME
        ItemDisplay[MAG cm1]: Small Charm%CONTINUE%
        ItemDisplay[MAG cm2]: Large Charm%CONTINUE%
        ItemDisplay[MAG cm3]: Grand Charm%CONTINUE%
    // JEWEL NAME
        ItemDisplay[jew]: %BASENAME%%CONTINUE%
    // QUIVER'S NAME
        ItemDisplay[(MAG OR RARE OR CRAFT OR UNI) (aq2 OR cq2)]: %BASENAME%%CONTINUE%
    // SYNTH
        ItemDisplay[SYNTH]: %BASENAME%%CONTINUE%
    // UNI/SET/RARE/CRAFT BASE
        ItemDisplay[(UNI OR SET OR RARE OR CRAFT) !RW !jew !cm1 !cm2 !cm3 !aq2 !cq2 !MAP]: %BASENAME%%CONTINUE%
    // RUNEWORD
        ItemDisplay[(WEAPON OR ARMOR) RW]: %GRAY%%BASENAME%%CONTINUE%
    // CIRCLET
        ItemDisplay[EQ7 (MAG OR RARE OR CRAFT) !RW (!ID OR CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%CONTINUE%            

// ITEM STATS
    // TIERS/WEIGHT
        EnableIf[CLVL<80]
            ItemDisplay[(WEAPON OR ARMOR)  EXC]: %NAME%%GRAY%[exc]%CONTINUE%
            ItemDisplay[(WEAPON OR ARMOR)  ELT]: %NAME%%GRAY%[elt]%CONTINUE%
            ItemDisplay[(qui OR lea OR hla OR stu OR brs OR xui OR ltp OR xea OR xla OR xtu OR xrs OR xtp OR uui OR uea OR ula OR utu OR urs OR utp OR buc OR sml OR kit OR bsh OR spk OR xuc OR xml OR xit OR xsh OR xpk OR uuc OR uml OR uit OR ush OR upk OR CL3 OR CL4)]: %NAME%%GRAY%[l]%CONTINUE%
            ItemDisplay[(rng OR chn OR spl OR fld OR gth OR aar OR xng OR xhn OR xpl OR xld OR xth OR xar OR ung OR uhn OR upl OR uld OR uth OR uar OR lrg OR gts OR xrg OR xts OR urg OR uts)]: %NAME%%GRAY%[m]%CONTINUE%
            ItemDisplay[(scl OR plt OR ful OR xcl OR xlt OR xul OR ucl OR ult OR uul OR tow OR xow OR uow)]: %NAME%%GRAY%[h]%CONTINUE%
        EndIf[]
        ItemDisplay[(WEAPON OR ARMOR OR jew OR amu OR rin OR cm1 OR cm2 OR cm3 OR aq2 OR cq2)]: %NAME%%CONTINUE%
    // SPEED
        ItemDisplay[(WEAPON)]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]}%CONTINUE%
    // ETH/SOCKETS
        ItemDisplay[ETH !NMAG !INF !RW]: [e] %NAME%%CONTINUE%
        ItemDisplay[!RW !NMAG !INF !RW SOCK>0]: %NAME% (%SOCKETS%)%CONTINUE%
        ItemDisplay[!EQ2 !WP3 !WP7 !WP8 !7wa !7gm ETH NMAG !RW]: [e] %NAME%%CONTINUE%
        ItemDisplay[NMAG !RW SOCK>0]: %NAME% (%SOCKETS%)%CONTINUE%
    // PASS THRU
        ItemDisplay[WEAPON !WP5 !NMAG]: %NAME%{%NAME%%NL%}%CONTINUE%
    // SOCKETS  
        // MAG/RARE/SET/UNI
            ItemDisplay[MAG (buc OR xuc OR dgr OR dir OR 9dg OR 9di OR 7dg OR 7di OR wnd OR 9wn OR ywn)]: %NAME%{%NAME%%WHITE%Max Sockets:%TAN%(%DGREEN%Quest:%WHITE%1S}%CONTINUE% // (LQ Begin)
            ItemDisplay[!NMAG !MAG ID !WP5 (EQ1 OR EQ2 OR EQ3 OR CL3 OR CL4 OR WEAPON)]: %NAME%{%NAME%%WHITE%Max Sockets:%TAN%(%DGREEN%Quest:%WHITE%1S}%CONTINUE% // (LQ Begin)
            ItemDisplay[!(WP5 OR buc OR xuc OR dgr OR dir OR 9dg OR 9di OR 7dg OR 7di OR wnd OR 9wn OR ywn) MAG ID (EQ1 OR EQ2 OR EQ3 OR CL3 OR CL4 OR WEAPON)]: %NAME%{%NAME%%WHITE%Max Sockets:%TAN%(%DGREEN%Quest:%WHITE%2S}%CONTINUE% // (LQ Begin)
        // CORRUPT
            EnableIf[!NMAG ID]
                ItemDisplay[!WP5 !ETH (EQ1 OR EQ2 OR EQ3 OR CL3 OR CL4 OR WEAPON)]: %NAME%{%NAME%, %RED%Corrupts:%WHITE%}%CONTINUE% // OOC Begin
                ItemDisplay[!WP5 ETH (EQ1 OR EQ2 OR EQ3 OR CL3 OR CL4 OR WEAPON)]: %NAME%{%NAME%, %RED%Cant Corrupt%WHITE%}%CONTINUE% // OOC Begin
                ItemDisplay[!ETH (axe OR lax OR 9ax OR 9la OR 7ax OR 7la OR cst OR bst OR 8cs OR 8bs OR 6cs OR 6bs)]: %NAME%{%NAME%4S}%CONTINUE% // OOC _4
                ItemDisplay[!ETH (ltp OR brs OR rng OR xtp OR xrs OR xng OR xcl OR xhn OR xpl OR xld OR xlt OR lrg OR kit OR tow OR gts OR xrg OR xit OR xow OR xts OR urg OR upk OR ush OR wsd OR 2hs OR 9wd OR 92h OR 7wd OR 72h OR mst OR 9mt OR 7mt OR 9sp OR 7sp OR gsc OR 9qs OR 7qs OR lst OR 8ls OR 6ls OR spr OR 9sr OR 7sr OR bar OR 9b7 OR 7o7 OR sbw OR 8sb OR 6sb OR lxb OR 8lx OR 6lx)]: %NAME%{%NAME%3S}%CONTINUE% // OOC _3
                ItemDisplay[!ETH (qui OR lea OR hla OR stu OR scl OR chn OR spl OR fld OR plt OR xui OR xea OR xla OR xtu OR sml OR spk OR bsh OR xml OR xpk OR xsh OR uuc OR uml OR cap OR skp OR hlm OR fhl OR bhm OR xap OR xkp OR xlm OR xhl OR xh9 OR uap OR ukp OR ulm OR uhl OR CL4 OR ssd OR scm OR sbr OR flc OR 9ss OR 9sm OR 9sb OR 9fc OR 7ss OR 7sm OR 7sb OR 7fc OR bld OR 9bl OR 7bl OR hax OR 9ha OR 7ha OR clb OR spc OR 9cl OR 7cl OR mac OR 9ma OR 7ma OR scp OR 9sc OR 7sc OR sst OR 8ss OR 6ss OR bwn OR gwn OR 9yw OR 9bw OR 9gw OR 7wn OR 7yw OR 7bw OR 7gw OR ktr OR wrb OR axf OR ces OR 9wb OR 9xf OR 9cs OR 7xf OR 7cs OR CL6) !(ob5 OR oba OR obf)]: %NAME%{%NAME%2S}%CONTINUE% // OOC _2
                ItemDisplay[!ETH (buc OR xuc OR dgr OR dir OR 9dg OR 9di OR 7dg OR 7di OR wnd OR 9wn OR ywn)]: %NAME%{%NAME%%GOLD%1S}%CONTINUE% // OOC _1
                ItemDisplay[!ETH ILVL<26 (wst OR 8ws OR 6ws)]: %NAME%{%NAME%5S}%CONTINUE% // ILVL<26 OOC _5
                ItemDisplay[!ETH ILVL<26 (2ax OR mpi OR wax OR bax OR btx OR gax OR gix OR 92a OR 9mp OR 9wa OR 9ba OR 9bt OR 9ga OR 9gi OR 72a OR 7mp OR 7wa OR 7ba OR 7bt OR 7ga OR 7gi)]: %NAME%{%NAME%4S}%CONTINUE% // ILVL<26 OOC _4
                ItemDisplay[!ETH ILVL<26 (gth OR ful OR aar OR xth OR xul OR xar OR uui OR uea OR ula OR utu OR ung OR ucl OR uhn OR urs OR upl OR ult OR uld OR uth OR uul OR uar OR utp OR CL3 OR crs OR bsd OR lsd OR clm OR gis OR bsw OR flb OR gsd OR 9cr OR 9bs OR 9ls OR 9cm OR 9gs OR 9b9 OR 9fb OR 9gd OR 7cr OR 7bs OR 7ls OR 7cm OR 7gs OR 7b7 OR 7fb OR 7gd OR fla OR 9fl OR 7fl OR whm OR mau OR gma OR 9wh OR 9m9 OR 9gm OR 7wh OR 7m7 OR 7gm OR wsp OR 9ws OR 7ws OR tri OR brn OR spt OR pik OR 9tr OR 9br OR 9st OR 9p9 OR 7tr OR 7br OR 7st OR 7p7 OR vou OR scy OR pax OR hal OR wsc OR 9vo OR 9s8 OR 9pa OR 9h9 OR 9wc OR 7vo OR 7s8 OR 7pa OR 7h7 OR 7wc OR WP9 OR WP10 OR uit OR uow OR uts OR am3 OR am4 OR am8 OR am9 OR amd OR ame) !(sbw OR 8sb OR 6sb OR lxb OR 8lx OR 6lx)]: %NAME%{%NAME%3S}%CONTINUE% // ILVL<26 OOC _3
                ItemDisplay[!ETH ILVL<26 (ghm OR msk OR crn OR xhm OR xsk OR xrn OR uhm OR usk OR urn OR uh9 OR CL1 OR CL2 OR kri OR 9kr OR 7kr OR clw OR btl OR skr OR 9ar OR 9lw OR 9tw OR 9qr OR 7ar OR 7wb OR 7lw OR 7tw OR 7qr OR ob5 OR oba OR obf)]: %NAME%{%NAME%2S}%CONTINUE% // ILVL<26 OOC _2
                ItemDisplay[!ETH ILVL<26 (ci0 OR ci1 OR ci2 OR ci3)]: %NAME%{%NAME%1S}%CONTINUE% // ILVL<26 OOC _1
                ItemDisplay[!ETH ILVL>25 (wst OR 8ws OR 6ws)]: %NAME%{%NAME%6S}%CONTINUE% // ILVL>25 OOC _6
                ItemDisplay[!ETH ILVL>25 (2ax OR bax OR btx OR 92a OR 9ba OR 9bt OR 72a OR 7ba OR 7bt OR wsp OR 9ws OR 7ws)]: %NAME%{%NAME%5S}%CONTINUE% // ILVL>25 OOC _5
                ItemDisplay[!ETH ILVL>25 (gth OR ful OR aar OR xth OR xul OR xar OR uui OR uea OR ula OR utu OR ung OR ucl OR uhn OR urs OR upl OR ult OR uld OR uth OR uul OR uar OR utp OR CL3 OR bsd OR lsd OR clm OR gis OR bsw OR 9bs OR 9ls OR 9cm OR 9gs OR 9b9 OR 7bs OR 7ls OR 7cm OR 7gs OR 7b7 OR whm OR 9wh OR 7wh OR tri OR 9tr OR 7tr OR vou OR 9vo OR 7vo OR hbw OR cbw OR 8hb OR 8cb OR 6hb OR 6cb OR mxb OR 8mx OR 6mx)]: %NAME%{%NAME%4S}%CONTINUE% // ILVL>25 OOC _4
                ItemDisplay[!ETH ILVL>25 (CL1 OR CL2 OR kri OR 9kr OR 7kr OR clw OR btl OR skr OR 9ar OR 9lw OR 9tw OR 9qr OR 7ar OR 7wb OR 7lw OR 7tw OR 7qr OR ob5 OR oba OR obf)]: %NAME%{%NAME%3S}%CONTINUE% // ILVL>25 OOC _3
                ItemDisplay[!ETH ILVL>25 (ci0 OR ci1)]: %NAME%{%NAME%2S}%CONTINUE% // ILVL>25 LQ _2
                ItemDisplay[!ETH ILVL<41 ILVL>25 (mpi OR wax OR gax OR gix OR 9mp OR 9wa OR 9ga OR 9gi OR 7mp OR 7wa OR 7ga OR 7gi)]: %NAME%{%NAME%5S}%CONTINUE% // ILVL<41 ILVL>25 OOC _5
                ItemDisplay[!ETH ILVL<41 ILVL>25 !WP5 (crs OR flb OR gsd OR 9cr OR 9fb OR 9gd OR 7cr OR 7fb OR 7gd OR fla OR 9fl OR 7fl OR mau OR gma OR 9m9 OR 9gm OR 7m7 OR 7gm OR brn OR spt OR pik OR 9br OR 9st OR 9p9 OR 7br OR 7st OR 7p7 OR scy OR pax OR hal OR wsc OR 9s8 OR 9pa OR 9h9 OR 9wc OR 7s8 OR 7pa OR 7h7 OR 7wc OR lbw OR sbb OR lbb OR swb OR lwb OR 8lb OR 8s8 OR 8l8 OR 8sw OR 8lw OR 6lb OR 6s7 OR 6l7 OR 6sw OR 6lw OR hxb OR rxb OR 8hx OR 8rx OR 6hx OR 6rx OR CL7)]: %NAME%{%NAME%4S}%CONTINUE% // ILVL<41 ILVL>25 LQ _4
                ItemDisplay[!ETH ILVL<41 ILVL>25 (uit OR uow OR uts)]: %NAME%{%NAME%3S}%CONTINUE% // ILVL<41 ILVL>25 LQ _3
                ItemDisplay[!ETH ILVL<41 ILVL>25 (ghm OR crn OR msk OR xhm OR xrn OR xsk OR uhm OR urn OR usk OR uh9 OR ci2 OR ci3)]: %NAME%{%NAME%2S}%CONTINUE% // ILVL<41 ILVL>25 OOC _2
                ItemDisplay[!ETH ILVL>40 (crs OR gsd OR 9cr OR 9gd OR 7cr OR 7gd OR mpi OR wax OR gax OR gix OR 9mp OR 9wa OR 9ga OR 9gi OR 7mp OR 7wa OR 7ga OR 7gi OR mau OR gma OR 9m9 OR 9gm OR 7m7 OR 7gm OR spt OR pik OR 9st OR 9p9 OR 7st OR 7p7 OR hal OR wsc OR 9h9 OR 9wc OR 7h7 OR 7wc OR lwb OR 8lw OR 6lw OR hxb OR 8hx OR 6hx OR am3 OR am4 OR am8 OR am9 OR amd OR ame OR lbb OR 8l8 OR 6l7)]: %NAME%{%NAME%6S}%CONTINUE% // ILVL>40 OOC _6
                ItemDisplay[!ETH ILVL>40 (flb OR 9fb OR 7fb OR fla OR 9fl OR 7fl OR brn OR 9br OR 7br OR scy OR pax OR 9s8 OR 9pa OR 7s8 OR 7pa OR lbw OR sbb OR swb OR 8lb OR 8s8 OR 8sw OR 6lb OR 6s7 OR 6sw OR rxb OR 8rx OR 6rx OR am1 OR am2 OR am6 OR am7 OR amb OR amc)]: %NAME%{%NAME%5S}%CONTINUE% // ILVL>40 OOC _5
                ItemDisplay[!ETH ILVL>40 (uit OR uow OR uts)]: %NAME%{%NAME%4S}%CONTINUE% // ILVL>40 OOC _4
                ItemDisplay[!ETH ILVL>40 (msk OR xsk OR usk OR uh9 OR ghm OR xhm OR uhm OR crn OR xrn OR urn OR ci2 OR ci3)]: %NAME%{%NAME%3S}%CONTINUE% // ILVL>40 OOC _3
                ItemDisplay[!WP5 (EQ1 OR EQ2 OR EQ3 OR CL3 OR CL4 OR WEAPON)]: %NAME%{%NAME%%TAN%)}%CONTINUE% // LQ/OOC End
            EndIf[]
        // UPGADE SOCKETS
            EnableIf[!NMAG !MAG ID !ETH]
                ItemDisplay[(bhm OR spk OR bsh OR wrb) ILVL>25]: %NAME%{%NAME% %WHITE%Upgrade*2:%TAN%(%RED%Corrupts:%ORANGE%3S%TAN%)}%CONTINUE%
                ItemDisplay[(qui OR lea OR hla OR stu OR brs OR ltp OR kit OR tow OR gts OR rng) ILVL>25]: %NAME%{%NAME% %WHITE%Upgrade*2:%TAN%(%RED%Corrupts:%ORANGE%4S%TAN%)}%CONTINUE%
                ItemDisplay[(xh9 OR scl OR chn OR spl OR plt OR fld OR xsh OR xpk OR ci0 OR ci1 OR spc OR ktr OR 9wb) ILVL>25]: %NAME%{%NAME% %WHITE%Upgrade:%TAN%(%RED%Corrupts:%ORANGE%3S%TAN%)}%CONTINUE%
                ItemDisplay[(buc OR wnd)]: %NAME%{%NAME% %WHITE%Upgrade*2: %TAN%(%RED%Corrupts:%ORANGE%2S%TAN%)}%CONTINUE%
                ItemDisplay[(xuc OR 9wn OR ywn)]: %NAME%{%NAME% %WHITE%Upgrade:%TAN%(%RED%Corrupts:%ORANGE%2S%TAN%)}%CONTINUE%
                ItemDisplay[(xui OR xea OR xla OR xtu OR xng OR xcl OR xhn OR xrs OR xpl OR xlt OR xld OR xtp OR xit OR xow OR xts) ILVL>25]: %NAME%{%NAME% %WHITE%Upgrade:%TAN%(%RED%Corrupts:%ORANGE%4S%TAN%)}%CONTINUE%
            EndIf[]
                ItemDisplay[SET ID urn STAT234>0]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%1-2S%TAN%)}%CONTINUE%  
        // FIXED
            EnableIf[UNI ID]
                ItemDisplay[urn ALLSK>0 STAT36>9 RES>0]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%1-2S%TAN%)}%CONTINUE%  
                ItemDisplay[(xng OR ung) STAT216>0 FRES>4]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%  
                ItemDisplay[(xul OR uul) STAT121>29 STAT118>0]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%3S%TAN%)}%CONTINUE%
                ItemDisplay[(xml OR uml) FBR>29 RES>25 ED>179]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[ush FRES>19 PRES>29 STAT86>4]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%3S%TAN%)}%CONTINUE%
                ItemDisplay[72a STAT44>4]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%3-5S%TAN%)}%CONTINUE%
                ItemDisplay[7sm STAT145>2 STAT121>99]: %NAME%{%WHITE%[Base Speed: -20, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%1-2S%TAN%)}%CONTINUE%
                ItemDisplay[(9fc OR 7fc) STAT240>0]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[(9st OR 7st) STAT252>0 STAT136>44]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%3S%TAN%)}%CONTINUE%
                ItemDisplay[7o7 STAT117>0 IAS>29]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%2-3S%TAN%)}%CONTINUE%
                ItemDisplay[7pa STAT124>249]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%1-3S%TAN%)}%CONTINUE%
                ItemDisplay[(8s8 OR 6s7) STAT250>0]: %NAME%{%WHITE%[Base Speed: %WPNSPD%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[6hx STAT49>323 STAT51>323 STAT55>323]: %NAME%{%WHITE%[Base Speed: %WPNSPD%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[uh9 STR>24 STAT136>9]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%1-2S%TAN%)}%CONTINUE%
                ItemDisplay[upk STAT238>0 STAT36>14]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%1S%TAN%)}%CONTINUE%
                ItemDisplay[wsd]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%3S%TAN%)}%CONTINUE%
            EndIf[]
            EnableIf[SET ID]
                ItemDisplay[lbb]: %NAME%{%WHITE%[Base Speed: %WPNSPD%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%4S%TAN%)}%CONTINUE%
                ItemDisplay[(ba5 OR baa OR baf)]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[paf]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%3S%TAN%)}%CONTINUE%
                ItemDisplay[(dr8 OR drd)]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[7ws]: %NAME%{%WHITE%[Base Speed: -10, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%3-4S%TAN%)}%CONTINUE%
                ItemDisplay[(xar OR uar) TABSK26>1]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%3S%TAN%)}%CONTINUE%
                ItemDisplay[7m7]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%2S%TAN%)}%CONTINUE%
                ItemDisplay[ucl]: %NAME%{%WHITE%Fixed Sockets:%TAN%(%WHITE%1-3S%TAN%)}%CONTINUE%
                ItemDisplay[(9mt OR 7mt)]: %NAME%{%WHITE%[Base Speed: %WPNSPD%, Range: %RANGE%]%NL%%WHITE%Fixed Sockets:%TAN%(%WHITE%2-3S%TAN%)}%CONTINUE%
            EndIf[]         
        // PASS THRU
            ItemDisplay[NMAG !RW SOCK=0 !WP5 WEAPON]: %NAME%{%NAME%%NL%}%CONTINUE% 
        // CUBE SOCKETS
            EnableIf[NMAG !INF !SUP !RW SOCK=0]
                ItemDisplay[EQ1]: %NAME%{%NAME%%GOLD%Cube Sockets:[Ral+Thul+%BLUE%PⓄ%GOLD%]%WHITE%:}%CONTINUE% // Helm/Circlet Begin
                ItemDisplay[EQ2]: %NAME%{%NAME%%GOLD%Cube Sockets:[Tal+Thul+%YELLOW%PⓄ%GOLD%]%WHITE%:}%CONTINUE% // Armor Begin
                ItemDisplay[(EQ3 OR CL3 OR CL4)]: %NAME%{%NAME%%GOLD%Cube Sockets:[Tal+Amn+%RED%PⓄ%GOLD%]%WHITE%:}%CONTINUE% // Shield Begin
                ItemDisplay[!WP5 WEAPON]: %NAME%{%NAME%%GOLD%Cube Sockets:[Ral+Amn+%PURPLE%PⓄ%GOLD%]%WHITE%:}%CONTINUE% // Weapon Begin
                ItemDisplay[!WP5 (EQ1 OR EQ2 OR EQ3 OR CL3 OR CL4 OR WEAPON) !(buc OR xuc OR dgr OR dir OR 9dg OR 9di OR 7dg OR 7di OR wnd OR 9wn OR ywn)]: %NAME%{%NAME%%GOLD%1-}%CONTINUE% // Runes/Gems _1-
                ItemDisplay[(axe OR lax OR 9ax OR 9la OR 7ax OR 7la OR cst OR bst OR 8cs OR 8bs OR 6cs OR 6bs)]: %NAME%{%NAME%4S}%CONTINUE% // Runes/Gems _4
                ItemDisplay[(ltp OR brs OR rng OR xtp OR xrs OR xng OR xcl OR xhn OR xpl OR xld OR xlt OR lrg OR kit OR tow OR gts OR xrg OR xit OR xow OR xts OR urg OR upk OR ush OR wsd OR 2hs OR 9wd OR 92h OR 7wd OR 72h OR mst OR 9mt OR 7mt OR 9sp OR 7sp OR gsc OR 9qs OR 7qs OR lst OR 8ls OR 6ls OR spr OR 9sr OR 7sr OR bar OR 9b7 OR 7o7 OR sbw OR 8sb OR 6sb OR lxb OR 8lx OR 6lx)]: %NAME%{%NAME%3S}%CONTINUE%  // Runes/Gems _3
                ItemDisplay[(qui OR lea OR hla OR stu OR scl OR chn OR spl OR fld OR plt OR xui OR xea OR xla OR xtu OR sml OR spk OR bsh OR xml OR xpk OR xsh OR uuc OR uml OR cap OR skp OR hlm OR fhl OR bhm OR xap OR xkp OR xlm OR xhl OR xh9 OR uap OR ukp OR ulm OR uhl OR CL4 OR ssd OR scm OR sbr OR flc OR 9ss OR 9sm OR 9sb OR 9fc OR 7ss OR 7sm OR 7sb OR 7fc OR bld OR 9bl OR 7bl OR hax OR 9ha OR 7ha OR clb OR spc OR 9cl OR 7cl OR mac OR 9ma OR 7ma OR scp OR 9sc OR 7sc OR sst OR 8ss OR 6ss OR bwn OR gwn OR 9yw OR 9bw OR 9gw OR 7wn OR 7yw OR 7bw OR 7gw OR ktr OR wrb OR axf OR ces OR 9wb OR 9xf OR 9cs OR 7xf OR 7cs OR CL6) !(ob5 OR oba OR obf)]: %NAME%{%NAME%2S}%CONTINUE% // Runes/Gems _2
                ItemDisplay[(buc OR xuc OR dgr OR dir OR 9dg OR 9di OR 7dg OR 7di OR wnd OR 9wn OR ywn)]: %NAME%{%NAME%%GOLD%1S}%CONTINUE% // Runes/Gems _1
