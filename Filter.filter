            ItemDisplay[(CL4 OR WP12) !UNI ((CLSK2=2 AND (SK79=3 OR SK94=3 OR SK95=3 OR SK74=3 OR SK67=3 OR SK84=3 OR SK93=3 OR SK83=3 OR SK92=3 OR SK66=3 OR SK87=3 OR SK91=3 OR SK69=3 OR SKILL("Hemorrhage")=3)) OR (TABSK16=3 AND (SK66>1 OR SK87>1 OR SK91>1 OR SKILL("Hemorrhage")>1)) OR (TABSK16=2 AND (SK66>2 OR SK87>2 OR SK91>2 OR SKILL("Hemorrhage")>2)) OR (TABSK17=3 AND (SK79>1 OR SK74>1 OR SK83>1 OR SK84>1 OR SK92>1 OR SK93>1)) OR (TABSK17=2 AND (SK79>2 OR SK74>2 OR SK83>2 OR SK84>2 OR SK92>2 OR SK93>2)) OR (TABSK18=3 AND (SK69>1 OR SK79>1 OR SK94>1 OR SK95>1)) OR (TABSK18=2 AND (SK69>2 OR SK79>2 OR SK94>2 OR SK95>2)))]: %BLUE%%NAME%%NOTIFY(WHITE)% 
        // SORCERESS
        // AMAZON
            ItemDisplay[(am5 OR ama OR amf) MAG !ID FILTERLVL=1]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[(am5 OR ama OR amf) !UNI (TABSK2>4 OR (TABSK2>2 AND CLSK0=2))]: %NAME%%NOTIFY(WHITE)%  // 5~6 AMA jav
        // AMULET & RING
            ItemDisplay[(rin OR amu) MAG !ID (CLVL<81 OR FILTERLVL=1)]: %NAME% 
            ItemDisplay[(rin OR amu) MAG !ID ILVL>89 FILTERLVL<4]: %NAME% 
            ItemDisplay[amu MAG (TABSK0=3 OR TABSK1=3 OR TABSK2=3 OR TABSK8=3 OR TABSK9=3 OR TABSK10=3 OR TABSK16=3 OR TABSK17=3 OR TABSK18=3 OR TABSK24=3 OR TABSK25=3 OR TABSK26=3 OR TABSK32=3 OR TABSK33=3 OR TABSK34=3 OR TABSK40=3 OR TABSK41=3 OR TABSK42=3 OR TABSK48=3 OR TABSK49=3 OR TABSK50=3)]: %NAME%%BORDER(4,1)%
            ItemDisplay[(amu OR EQ7) MAG STAT388=2 (TABSK18=3 OR TABSK40)  ]: %NAME%%RED% [+5 Summon]<<HIGH>>   
            ItemDisplay[rin OR amu MAG ID]: %NAME%  
    // RARE
        EnableIf[RARE]
            ItemDisplay[(WEAPON OR ARMOR) CLVL<60 !ID]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[(WEAPON OR ARMOR) ELT CLVL<80 !ID]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]  
            ItemDisplay[(rin OR amu OR EQ7) !ID FILTERLVL<4]: %YELLOW%✠ %NAME% ✠<<LOW>>
            ItemDisplay[(crs OR 9cr OR 7cr OR mpi OR wax OR 9mp OR 9wa OR 7mp OR 7wa OR WP12) !ID FILTERLVL=1]: %NAME%   
            //ItemDisplay[(CL5 OR am5 OR ama OR amf) !ID FILTERLVL=1]: %NAME%  
            ItemDisplay[(aq2 OR cq2) !ID FILTERLVL=1]: %NAME%
            ItemDisplay[(aq2 OR cq2) ((STAT218=5 AND STAT21>8 AND (ALLSK>0 OR ALLSK>0 OR TABSK0>0 OR STAT156>0 OR STAT62>0 OR STAT141>0 OR RES>0 OR IAS>0 OR STAT136>0 OR FRW>0)) OR (ALLSK>0 AND RES>9) OR (TABSK0=2 AND STAT156>9 AND (RES>0 OR IAS>0 OR STAT141>0 OR STAT136>0 OR FRW>0 OR STAT62>0)) OR (ALLSK>0 STAT156>14 AND (RES>0 OR IAS>0 OR STAT141>0 OR STAT136>0 OR FRW>0 OR STAT62>0)))]: %NAME%
            ItemDisplay[(EQ4 OR EQ5 OR EQ6 OR CL4) FILTERLVL=1]: %NAME%    
        EndIf[]
        ItemDisplay[(WEAPON OR ARMOR OR aq2 OR cq2 OR rin OR amu) (RARE OR CRAFT) ID]: %NAME%       
    // SET
        EnableIf[SET]
            ItemDisplay[!ID (xhm OR paf OR 7qr OR xtb OR uar OR xmg OR uth OR amu)]: %NL%%GREEN%%NAME%%NL%%SPACE%<<HIGH>>
            ItemDisplay[(uh9 OR utc OR ne9 OR ulg OR oba OR xul OR 6cs OR ult) !ID FILTERLVL<4]: %GREEN%%NAME%<<LOW>>
            ItemDisplay[(hgl OR tow OR hbl OR hbt OR gth OR ghm OR mbl OR mbt OR gsc OR sbr OR rin) !ID FILTERLVL=1]: %GREEN%%NAME%{%WHITE%Leveling item}<<LEVEL>>
            ItemDisplay[!ID FILTERLVL=1]: %NAME% 
            ItemDisplay[ID]: %NAME%%NL%%GREEN%%ITEMNAME% 
        EndIf[]
    // UNIQUE
        // SYNTH
            ItemDisplay[SPECIAL OR SYNTH]: %NL%%GOLD%✠%YELLOW%✠ %GOLD%Synth %ITEMNAME% %YELLOW%✠%GOLD%✠%NL%%SPACE%<<HIGH>>
        EnableIf[UNI]    
            // ETH HIGH VALUE
                ItemDisplay[(ama OR 7pa OR uvb OR 7s8) ETH !ID]: %NL%%GOLD%✠✠%TAN%✠✠%GRAY%✠✠ %RED%[e] %GOLD%%NAME%  %GRAY%✠✠%TAN%✠✠%GOLD%✠✠%NL%%SPACE%<<HIGH>>
            // HIGH VALUE
                ItemDisplay[(rin OR amu OR xh9 OR uap OR ulm OR usk OR urn OR ci3 OR upl OR uar OR uit OR xtb OR ulc OR 6lw OR 7gw OR pa9 OR nea) !ID]: %NL%%GOLD%✠✠✠  %NAME%  ✠✠✠%NL%%SPACE%<<HIGH>>
            // MID VALUE
                ItemDisplay[(xmg OR tgl OR xsh OR obc OR uhb OR xea OR baa OR uvb OR 6cs OR ama OR uow OR umb OR uvg OR utu OR xmb OR xlt OR xpl OR uui OR uvg OR ci2 OR dra OR xea OR xhn OR xhb OR 6ws OR 9bs OR dgr OR xts OR 7cr OR 7s8 OR zlb OR zhb OR umc OR 9ls OR xvb) !ID]: %NL%%GOLD%✠✠  %NAME%  ✠✠%NL%%SPACE%<<MID>>
                //ItemDisplay[(tgl OR xsh OR obc OR uhb OR xea OR baa OR uvb OR 6cs OR ama OR uow OR umb OR uvg OR utu OR xmb OR xlt OR xpl OR uui OR uvg OR ci2 OR dra) !ID FILTERLVL<4]: %NL%%GOLD%✠  %NAME%  ✠%NL%%SPACE%<<MID>>
            // LEVEL
                ItemDisplay[(xap OR stu OR skp OR bsh OR gth OR 7p7 OR gts) !ID FILTERLVL=1]: %GOLD%%NAME%{%WHITE%Leveling item}<<LEVEL>>
            // UNIQUE END
                ItemDisplay[!ID FILTERLVL=1]: %NAME%  
                ItemDisplay[ID]: %NAME%%NL%%GOLD%%ITEMNAME% 
        EndIf[]    
    // NMAG
        EnableIf[!INF !RW NMAG]
            ItemDisplay[(WEAPON OR ARMOR) CLVL<6]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            //ItemDisplay[(WEAPON OR ARMOR) CLVL<12 (SOCK>0 OR WP11 OR WP12 OR WP13)]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            //ItemDisplay[(WEAPON OR ARMOR) !NORM CLVL<30]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            //ItemDisplay[(WEAPON OR ARMOR) !NORM CLVL<40 SOCK>0]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            //ItemDisplay[(WEAPON OR ARMOR) ELT  CLVL<60]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
        EndIf[]

// VENDOR ITEMS OLD
    // 1x2
        EnableIf[(7tk OR 7ta OR 7bk OR CL6 OR WP12 OR EQ6) (NMAG OR MAG OR RARE) (!ID OR ID) !RW]
            ItemDisplay[FILTERLVL=1 PRICE>34999 ILVL>85]: %WHITE%[%YELLOW%35K%WHITE%]
            ItemDisplay[PRICE>19999 ILVL<86]: %WHITE%[1x2][%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[PRICE>9999 CLVL<50]: %WHITE%[1x2][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>2999 CLVL<20]: %WHITE%[1x2][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>999 CLVL<8]: %WHITE%[1x2][%YELLOW%%PRICE%%WHITE%]
        EndIf[]    
    // 1x3
        EnableIf[(sst OR 8ss OR 6ss OR am5 OR ama OR amf OR CL5 OR scp OR 9sc OR 7sc OR gsc OR 9qs OR 7qs OR jav OR 9ja OR 7ja OR pil OR 9pi OR 7pi OR ssp OR 9s9 OR 7s7) (NMAG OR MAG OR RARE) (!ID OR ID) !RW]
            ItemDisplay[PRICE>24999 ILVL<86]: %WHITE%[1x3][%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[PRICE>14999 CLVL<50]: %WHITE%[1x3][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>4999 CLVL<20]: %WHITE%[1x3][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>999 CLVL<8]: %WHITE%[1x3][%YELLOW%%PRICE%%WHITE%]
        EndIf[]
    // 2x2
        EnableIf[(EQ1 OR EQ4 OR EQ5 OR EQ7 OR CL4 OR pa1 OR pa6 OR pab OR pa2 OR pa7 OR pac OR pa5 OR paa OR paf) (NMAG OR MAG OR RARE) (!ID OR ID) !RW]
            ItemDisplay[PRICE>24999 ILVL<86]: %WHITE%[2x2][%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[PRICE>14999 CLVL<50]: %WHITE%[2x2][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>4999 CLVL<20]: %WHITE%[2x2][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>999 CLVL<8]: %WHITE%[2x2][%YELLOW%%PRICE%%WHITE%]
        EndIf[]
    // 2x4
        EnableIf[(gts OR xts OR uts OR wst OR 8ws OR 6ws) (NMAG OR MAG OR RARE) (!ID OR ID) !RW]
            ItemDisplay[PRICE>34999 ILVL<86]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[PRICE>19999 CLVL<50]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>9999 CLVL<20]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>3999 CLVL<8]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%]
        EndIf[]
    // 1x4
        EnableIf[(WP11 OR glv OR 9gl OR 7gl OR tsp OR 9ts OR 7ts) (NMAG OR MAG OR RARE) (!ID OR ID) !RW]
            ItemDisplay[PRICE>19999 ILVL<86]: %WHITE%[1x4][%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[PRICE>9999 CLVL<50]: %WHITE%[1x4][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>2999 CLVL<20]: %WHITE%[1x4][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>999 CLVL<8]: %WHITE%[1x4][%YELLOW%%PRICE%%WHITE%]
        EndIf[]
    // 2x3
        EnableIf[(EQ2 OR bal OR 9b8 OR 7b8 OR wsp OR 9ws OR 7ws) (NMAG OR MAG OR RARE) (!ID OR ID) !RW]
            ItemDisplay[PRICE>24999 ILVL<86]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[PRICE>14999 CLVL<50]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>4999 CLVL<20]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%] 
            ItemDisplay[PRICE>999 CLVL<8]: %WHITE%[2x3][%YELLOW%%PRICE%%WHITE%]
        EndIf[]               
             

// HIDE
    ItemDisplay[(WEAPON OR ARMOR OR aq2 OR cq2 OR aqv OR cqv) OR (!NMAG OR MAG OR RARE OR UNI OR SET)]:
    ItemDisplay[(vps OR wms OR yps OR key OR tsc OR isc) DIFFICULTY>0]:                 
