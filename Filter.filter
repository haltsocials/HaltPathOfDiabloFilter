        ItemDisplay[(lbw) NMAG !RW SOCK=4 ILVL<86]:%GRAY%%NAME%{%GRAY%Harmony:%GOLD%[Tir]+[Ith]+[Sol]+[Ko]%NL%%NAME%}<<LEVEL>> //Harmony Base (held)
        ItemDisplay[(WP8 OR WP7) EXC ETH SOCK=4 !RW NMAG FILTERLVL<4]: %GRAY%%NAME%{%NAME%}<<LEVEL>> //Insight Base
        //ItemDisplay[gth NMAG SOCK=4 !RW FILTERLVL<4]: %GRAY%%NAME%{PTopaz base}<<LEVEL>>
        // ACTIVE LEVEL
        ItemDisplay[(NMAG OR MAG OR RARE) !RW (WP11 OR CL6) PLRCLASS(SORCERESS) CLVL<25 (SKILL("Frost Nova")>0 OR SKILL("Charged Bolt")>0)]:%WHITE%%NAME%{%NAME%}<<LEVEL>> // Sorc Item
        ItemDisplay[(WP12 OR CL4) (NMAG OR MAG OR RARE) PLRCLASS(NECROMANCER) !RW CLVL<25 (SKILL("Teeth")>0 OR SKILL("Hemorrhage")>0)]: %WHITE%%NAME%{%NAME%} <<LEVEL>> // Necro Item
        ItemDisplay[CL4 (MAG OR RARE) PLRCLASS(NECROMANCER) !ID CLVL<81]: %ITEMNAME%{%NAME%} <<LEVEL>> // Necro Item
        ItemDisplay[CL1 !ETH (NMAG OR MAG OR RARE) PLRCLASS(DRUID) !RW CLVL<28 (SKILL("Fissure")>0  OR SKILL("Firestorm")>0 OR SKILL("Raven")>0 OR SKILL("Poison Creeper")>0)]: %NAME%{%NAME%}<<LEVEL>> // Druid Item
        ItemDisplay[(WP13) (NMAG OR MAG) !RW CLVL<25 PLRCLASS(PALADIN) SKILL("Holy Fire")>0]: %WHITE%%NAME%{%NAME%} <<LEVEL>> // Paladin Item
        ItemDisplay[EQ1 !ETH NMAG !RW CLVL<17 SOCK=2]: %GRAY%%NAME%{%NAME%}<<LEVEL>> //Lore/Sapphire Base
        ItemDisplay[(qui OR lea OR hla OR stu) !ETH NMAG !RW CLVL<17 SOCK=2]: %GRAY%%NAME%{%GRAY%Stealth:%GOLD%[Tal]+[Eth]%NAME%}<<LEVEL>> //Stealth/Sapphire Base
        ItemDisplay[(kit OR lrg) !ETH NMAG !RW CLVL<30 SOCK=3]: %GRAY%%NAME%{%GRAY%Anceint's Pledge:%GOLD%[Ral]+[Ort]+[Tal]%NL%%NAME%}<<LEVEL>> //Ancients's Pledge Base
        ItemDisplay[bsh !ETH NMAG !RW CLVL<50 SOCK=2]: %GRAY%%NAME%{%NAME%}<<LEVEL>> //Rhyme Base
        ItemDisplay[WP9 (NMAG OR MAG) !RW CLVL<30 SOCK=3 CLVL<12]: %GRAY%%NAME%{%GRAY%A1 Merc Gemmed or Edge}<<LEVEL>>
        ItemDisplay[(WP8 OR WP7) NMAG !RW CLVL<25 SOCK=3]: %GRAY%%NAME%{%GRAY%Malice:%GOLD%[Ith]+[El]+[Eth]%NAME%}<<LEVEL>> //Malice/Gems 
        ItemDisplay[(6hb OR 6cb OR 6s7 OR 6lb OR 8hb OR 8cb OR 8s8 OR 8lb OR hbw OR lbw OR cbw OR sbb) NMAG !INF !RW SOCK=4 CLVL<60]: %GRAY%%NAME%{%NAME%}<<LEVEL>> //Insight Base (Bow)
        ItemDisplay[(WP7 OR WP8) !CL7 NMAG !INF !RW SOCK=4 CLVL<60]: %GRAY%%NAME%{%NAME%}<<LEVEL>> // Insight Base
        Itemdisplay[(EQ6 OR EQ4) (EXC OR ELT) MAG !ETH !RW !CRAFT CLVL<80]:%BLUE%%NAME%{%GOLD% Caster Craft%}<<LEVEL>>
    // !NMAG ITEM
        // CRAFTED
            EnableIf[CRAFTED !NMAG]
                ItemDisplay[((rin STR>0 STAT60>0 LIFE>9) OR (amu FRW>4 STAT60>0 LIFE>9) OR (GLOVES STAT136>4 STAT60>0 LIFE>9) OR (BELT STAT135>4 STAT60>0 LIFE>9) OR (BOOTS REPLIFE>4 STAT60>0 LIFE>9))]: %NAME%{%RED%Blood Type}%CONTINUE%
                ItemDisplay[((rin STAT1>0 STAT27>3 MANA>9) OR (amu FCR>4 STAT27>3 MANA>9) OR (GLOVES MAEK>0 STAT27>3 MANA>9) OR (BELT FCR>4 STAT27>3 MANA>9) OR (BOOTS STAT77>1 STAT27>3 MANA>9))]: %NAME%{%PURPLE%Caster Type}%CONTINUE%
                ItemDisplay[((rin STAT3>0 STAT34>0 STAT35>0) OR (amu STAT20>0 STAT34>0 STAT35>0) OR (GLOVES CRES>4 STAT34>0 STAT35>0) OR (BELT PRES>4 STAT34>0 STAT35>0) OR (BOOTS FRES>4 STAT34>0 STAT35>0))]: %NAME%{%GREEN%Safety Type}%CONTINUE%
                ItemDisplay[((rin STAT78>2) OR (amu STAT78>2) OR (GLOVES STAT78>2) OR (BELT STAT114>4 STAT78>2) OR (BOOTS STAT78>2))]: %NAME%{%YELLOW%Hitpower Type}%CONTINUE%
                ItemDisplay[((HELM STAT141>4 STAT60>0 LIFE>9) OR (WEAPON ED>34 STAT60>0 LIFE>9) OR (SHIELD STAT78>3 STAT60>0 LIFE>9) OR (EQ2 STAT139>0 STAT60>0 LIFE>9))]: %NAME%{%NAME%%NL%   %RED%Blood Type   }%CONTINUE%
                ItemDisplay[((HELM STAT62>0 STAT27>3 MANA>9) OR (WEAPON STAT77>0 STAT27>3 MANA>9) OR (SHIELD STAT20>4 STAT27>3 MANA>9) OR (EQ2 MAEK>1 STAT27>3 MANA>9))]: %NAME%{%NAME%%NL%   %PURPLE%Caster Type   }%CONTINUE%
                ItemDisplay[((HELM LRES>4 STAT34>0 STAT35>0) OR (WEAPON STAT34>0 STAT35>0) OR (SHIELD STAT37>4 STAT34>0 STAT35>0) OR (EQ2 STAT34>0 STAT35>0))]: %NAME%{%NAME%%NL%   %GREEN%Safety Type   }%CONTINUE%
                ItemDisplay[((HELM STAT78>2) OR (WEAPON ED>34 STAT78>2) OR (SHIELD STAT20>4 STAT78>2) OR (EQ2 FHR>9 STAT78>2))]: %NAME%{%NAME%%NL%   %YELLOW%Hitpower Type   }%CONTINUE%
            EndIf[]
        // AMULET
            EnableIf [amu !NMAG]
                ItemDisplay[amu !UNI !SET (FCR>0 OR FRW>0 OR STAT110>0 OR RES>9) (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%[%CONTINUE%  
                ItemDisplay[amu UNI ((ALLSK=1 !((STAT32>0 STAT60>0) OR (IAS>10 LRES>0))) OR (ALLSK=2 !(RES>19 OR TABSK26>0)) OR ALLSK=3)]: %NAME%%NL%%GOLD%[%CONTINUE%
                ItemDisplay[amu SET ALLSK=1 !(CRES>0 PRES>0 STAT78>0)]: %NAME%%NL%%GOLD%[%CONTINUE%
                ItemDisplay[amu !UNI !SET FCR>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%+%STAT(105,0)%%Fcr%CONTINUE%
                ItemDisplay[amu !UNI !SET FRW>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%+%STAT(96,0)%%FRW%CONTINUE%
                ItemDisplay[amu !UNI !SET RES>9 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%+%RES%All%CONTINUE%
                ItemDisplay[amu !UNI !SET STAT110>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%+%STAT(110,0)%%PLR%CONTINUE%
                ItemDisplay[amu !UNI !SET ALLSK>0]: %NAME%%RED%+1SKILL*%CONTINUE%<<MID>>
                ItemDisplay[amu UNI ((ALLSK=1 !((STAT32>0 STAT60>0) OR (IAS>10 LRES>0))) OR (ALLSK=2 !(RES>19 OR TABSK26>0)) OR ALLSK=3)]: %NAME%%RED%+1SKILL*%CONTINUE%<<MID>>
                ItemDisplay[amu SET ALLSK=1 !(CRES>0 PRES>0 STAT78>0)]: %NAME%%RED%+1SKILL*%CONTINUE%<<MID>>
                ItemDisplay[amu !UNI !SET (FCR>0 OR FRW>0 OR STAT110>0 OR RES>9) (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%]%CONTINUE%  //  AMU END
                ItemDisplay[amu UNI ((ALLSK=1 !((STAT32>0 STAT60>0) OR (IAS>10 LRES>0))) OR (ALLSK=2 !(RES>19 OR TABSK26>0)) OR ALLSK=3)]: %NAME%%GOLD%]%CONTINUE%  //  AMU END
                ItemDisplay[amu SET ALLSK=1 !(CRES>0 PRES>0 STAT78>0)]: %NAME%%GOLD%]%CONTINUE%  //  AMU END
                ItemDisplay[amu MAG ILVL>89]: %WHITE%*%BLUE%%NAME%{%ORANGE%Blood:[Amn]+Ruby+Jew%NL%Caster:[Ral]+Amethyst+Jew}%CONTINUE% // Cube AMU BASE
            EndIf[]
        // RING
            EnableIf[rin !NMAG]
                ItemDisplay[(FCR>0 OR FRW>0 OR STAT36>0)]: %NAME%%NL%%GOLD%[ %CONTINUE%
                ItemDisplay[FCR>0]: %NAME%%GOLD%+%STAT(105,0)%%FCR%CONTINUE%
                ItemDisplay[FRW>0]: %NAME%%GOLD%+%STAT(96,0)%%FRW%CONTINUE%
                ItemDisplay[STAT36>0]: %NAME%%GOLD%+%STAT(36,0)%%PDR%CONTINUE%
                ItemDisplay[(FCR>0 OR FRW>0 OR STAT36>0)]: %NAME%%GOLD%]%CONTINUE%  //  RING END
                ItemDisplay[MAG ILVL>89]: %WHITE%*%BLUE%%NAME%{%ORANGE%Blood:[Sol]+Ruby+Jew%NL%Caster:[Amn]+Amethyst+Jew}%CONTINUE% // Cube RING BASE
            EndIf[]
        // GLOVE
            ItemDisplay[EQ4 !NMAG IAS>0 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK50>1)]: %NAME%%GOLD%[+%STAT(93,0)%%IAS]%CONTINUE%<<MID>>
        // CIRCLET
            EnableIf[EQ7 !NMAG ID]
                ItemDisplay[(FCR>0 OR FRW>0) (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%[%CONTINUE%
                ItemDisplay[FCR>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%WHITE%+%STAT(105,0)%%%GOLD%FCR%CONTINUE% <<MID>>
                ItemDisplay[FRW>0 (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%WHITE%+%STAT(96,0)%%%GOLD%FRW%CONTINUE% <<MID>>
                ItemDisplay[(FCR>0 OR FRW>0) (CLSK0>0 OR CLSK1>0 OR CLSK2>0 OR CLSK3>0 OR CLSK4>0 OR CLSK5>0 OR CLSK6>0 OR TABSK0>0 OR TABSK1>0 OR TABSK2>0 OR TABSK8>0 OR TABSK9>0 OR TABSK10>0 OR TABSK16>0 OR TABSK17>0 OR TABSK18>0 OR TABSK24>0 OR TABSK25>0 OR TABSK26>0 OR TABSK32>0 OR TABSK33>0 OR TABSK34>0 OR TABSK40>0 OR TABSK41>0 OR TABSK42>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0)]: %NAME%%GOLD%]%CONTINUE%  //  Circlets END
            EndIf[]
        // SCEPTER
            ItemDisplay[WP13 !NMAG FCR>0 ((TABSK24=3 AND (SK121>1 OR SK101>1)) OR (TABSK24=2 AND (SK121>2 OR SK101>2)) OR (TABSK25=3 AND (SK119>1 OR SK102>1 OR SK114>1 OR SK118>1 OR SK113>1 OR SK122>1 OR SK123>1)) OR (TABSK25=3 AND SK125>1))]: %NAME%%GOLD%[+%STAT(105,0)%%Fcr]%CONTINUE%
        // JAVELIN
            ItemDisplay[(am5 OR ama OR amf) IAS>0 (TABSK2>4 OR (TABSK2>2 AND CLSK0=2))]: %NAME%%GOLD%[+%STAT(93,0)%%IAS]%CONTINUE%
        // CLAW
            EnableIf[CL5 !NMAG ID]
                ItemDisplay[IAS>0 STAT218=4 STAT224=33 (CLSK6>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0 OR SK274>0 OR SK267>0 OR SK278>0 OR SK273>0 OR SK258>0 OR SK262>0 OR SK272>0 OR SK271>0 OR SK276>0 OR SK277>0)]: %NAME%%GOLD%[%RED%Fool's MOD%GOLD%+%STAT(93,0)%%IAS]%CONTINUE%
                ItemDisplay[IAS>0 !(STAT218=4 STAT224=33) (CLSK6>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0 OR SK274>0 OR SK267>0 OR SK278>0 OR SK273>0 OR SK258>0 OR SK262>0 OR SK272>0 OR SK271>0 OR SK276>0 OR SK277>0)]: %NAME%%GOLD%[+%STAT(93,0)%%IAS]%CONTINUE%
                ItemDisplay[!IAS>0 STAT218=4 STAT224=33 (CLSK6>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0 OR SK274>0 OR SK267>0 OR SK278>0 OR SK273>0 OR SK258>0 OR SK262>0 OR SK272>0 OR SK271>0 OR SK276>0 OR SK277>0)]: %NAME%%GOLD%[%RED%Fool's MOD%GOLD%]%CONTINUE%
                ItemDisplay[IAS>0 STAT218=4 STAT224=33 !(CLSK6>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0 OR SK274>0 OR SK267>0 OR SK278>0 OR SK273>0 OR SK258>0 OR SK262>0 OR SK272>0 OR SK271>0 OR SK276>0 OR SK277>0)]: %NAME%%NL%%GOLD%[%RED%Fool's MOD%GOLD%+%STAT(93,0)%%IAS]%CONTINUE%
                ItemDisplay[!IAS>0 STAT218=4 STAT224=33 !(CLSK6>0 OR TABSK48>0 OR TABSK49>0 OR TABSK50>0 OR SK274>0 OR SK267>0 OR SK278>0 OR SK273>0 OR SK258>0 OR SK262>0 OR SK272>0 OR SK271>0 OR SK276>0 OR SK277>0)]: %NAME%%NL%%GOLD%[%RED%Fool's MOD%GOLD%]%CONTINUE%
            EndIf[]
        // ARROW & BOLT
            EnableIf[(aq2 OR cq2) !UNI]
                ItemDisplay[(STAT218>0 OR STAT21>0 OR ALLSK>0 OR TABSK0>0 OR STAT156>0 OR STAT62>0 OR STAT141>0 OR RES>0 OR IAS>0 OR STAT136>0 OR FRW>0  OR STAT495>0)]: %NAME%%NL%%GOLD%[%CONTINUE%  //  Arrows&Bolts Begin
                ItemDisplay[ALLSK=1]: %NAME%%GOLD%+1AllSkill%CONTINUE%
                ItemDisplay[ALLSK=2]: %NAME%%GOLD%+2AllSkill%CONTINUE%
                ItemDisplay[TABSK0=1]: %NAME%%GOLD%+1AMA(Bow)%CONTINUE%
                ItemDisplay[TABSK0=2]: %NAME%%GOLD%+2AMA(Bow)%CONTINUE%
                ItemDisplay[TABSK0=3]: %NAME%%GOLD%+3AMA(Bow)%CONTINUE%
                ItemDisplay[STAT495=1]: %NAME%%GOLD%+1Ele&PsnSkill%CONTINUE%
                ItemDisplay[STAT495=2]: %NAME%%GOLD%+2Ele&PsnSkill%CONTINUE%
                ItemDisplay[STAT218=3]: %NAME%%GOLD%+0.375MAX/Level%CONTINUE%
                ItemDisplay[STAT218=4]: %NAME%%GOLD%+0.5MAX/Level%CONTINUE%
                ItemDisplay[STAT218=5]: %NAME%%GOLD%+0.625MAX/Level%CONTINUE%
                ItemDisplay[STAT21>0]: %NAME%%GOLD%+%STAT(21,0)%-%CONTINUE%
                ItemDisplay[STAT21>0]: %NAME%%GOLD%%STAT(22,0)%DMG%CONTINUE%
                ItemDisplay[STAT156>0]: %NAME%%GOLD%+%STAT(156,0)%%Pierce%CONTINUE%
                ItemDisplay[STAT62>0]: %NAME%%GOLD%+%STAT(62,0)%%LM%CONTINUE%
                ItemDisplay[STAT141>0]: %NAME%%GOLD%+%STAT(141,0)%%DS%CONTINUE%
                ItemDisplay[RES>0]: %NAME%%GOLD%+%RES%%All%CONTINUE%
                ItemDisplay[IAS>0]: %NAME%%GOLD%+%STAT(93,0)%%IAS%CONTINUE%
                ItemDisplay[STAT136>0]: %NAME%%GOLD%+%STAT(136,0)%%CB%CONTINUE%
                ItemDisplay[FRW>0]: %NAME%%GOLD%+%STAT(96,0)%%FRW%CONTINUE%
                ItemDisplay[(STAT218>0 OR STAT21>0 OR ALLSK>0 OR TABSK0>0 OR STAT156>0 OR STAT62>0 OR STAT141>0 OR RES>0 OR IAS>0 OR STAT136>0 OR FRW>0  OR STAT495>0)]: %NAME%%GOLD%]%CONTINUE%  //  Arrows&Bolts END
            EndIf[]
        // FOOL'S MOD
            EnableIf[(MAG OR RARE) WEAPON !CL5]
                ItemDisplay[IAS>0 STAT218=4 STAT224=33]: %NAME%%NL%%GOLD%[%RED%Fool's MOD%GOLD%+%STAT(93,0)%%IAS]%CONTINUE%
                ItemDisplay[(MAG OR RARE) WEAPON !CL5 !IAS>0 STAT218=4 STAT224=33]: %NAME%%NL%%GOLD%[%RED%Fool's MOD%GOLD%]%CONTINUE%
            EndIf[]
    // MAG
        // LEVEL <50
            ItemDisplay[(ARMOR) MAG CLVL<13]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[(CL4 OR CL5 OR CL6 OR WP11 OR WP12 OR WP13) MAG CLVL<80]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
            ItemDisplay[(WEAPON OR ARMOR) (EXC OR ELT) MAG (CLVL>29 AND CLVL<50)]: %NAME% %WHITE%[%YELLOW%%PRICE%%WHITE%]
        // CIRCLET
            ItemDisplay[EQ7 MAG !ID FILTERLVL=1]: %NAME%  
